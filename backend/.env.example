# ========================================================
# CloudVault Backend Environment Configuration (Example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL
# ========================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# For local development with PostgreSQL:
DATABASE_URL=postgresql+psycopg://cloudvault_user:cloudvault_password@localhost:5432/cloudvault_db
# For zero-setup local dev / test fallback:
# DATABASE_URL=sqlite:///./cloudvault.db

# Storage Configuration
# Choose: 's3' for AWS S3 production or 'local' for local file storage development/testing
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# AWS S3 Configuration (Required when STORAGE_BACKEND=s3)
# In production on EC2 with IAM Role, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should be omitted.
AWS_REGION=us-east-1
S3_BUCKET_NAME=cloudvault-secure-storage-bucket-prod
# AWS_ACCESS_KEY_ID=your-dev-access-key-id
# AWS_SECRET_ACCESS_KEY=your-dev-secret-access-key
# AWS_ENDPOINT_URL=http://localhost:4566  # Optional: For LocalStack testing

# File Upload Limits & Controls
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB in bytes (10 * 1024 * 1024)
PRESIGNED_URL_EXPIRATION_SECONDS=900  # 15 minutes

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
